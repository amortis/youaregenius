# Секретный ключ приложения (в проде обязателен!)
SECRET_KEY=

# Ключ DeepL API (free tier) для авто-перевода. Пусто = перевод отключён.
DEEPL_API_KEY=

# Postgres URI для прода (пример):
# DATABASE_URI=postgresql+psycopg2://genius:password@localhost:5432/youaregenius

# SQLite для локальной разработки (значение по умолчанию использует sqlite:///youaregenius_dev.db)
# DEV_DATABASE_URI=

# User-Agent для запросов к genius.com
# GENIUS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:120.0) Gecko/20100101 Firefox/120.0